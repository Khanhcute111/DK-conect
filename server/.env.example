PORT=3000
DATABASE_URL=postgres://dkconnect:dkconnect_local_password@localhost:5432/dkconnect
JWT_SECRET=replace_with_a_long_random_secret_before_deploy
CORS_ORIGIN=*
# Admin is granted manually in PostgreSQL after account creation; never self-promote via signup.

# Optional: public HTTPS origin used to construct story/sticker media URLs.
# PUBLIC_BASE_URL=https://api.example.com
# UPLOAD_DIR=/var/data/dkconnect/uploads
